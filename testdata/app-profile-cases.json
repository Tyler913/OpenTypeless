  "resolution": [
    {
      "name": "no profile: the global settings as they are",
      "global": { "strength": "standard", "pressEnter": false, "language": "", "extraInstructions": "Keep my casual tone" },
      "profile": null,
      "expected": { "strength": "standard", "pressEnter": false, "language": "", "extraInstructions": "Keep my casual tone", "profileID": null, "profileName": null }
    },
    {
      "name": "a profile that sets nothing still names itself",
      "global": { "strength": "light", "pressEnter": false, "language": "zh", "extraInstructions": "" },
      "profile": { "id": "P1", "app": "com.apple.mail", "name": "Mail" },
      "expected": { "strength": "light", "pressEnter": false, "language": "zh", "extraInstructions": "", "profileID": "P1", "profileName": "Mail" }
    },
    {
      "name": "every override, clean-up off as older versions saved it",
      "global": { "strength": "standard", "pressEnter": false, "language": "", "extraInstructions": "" },
      "profile": { "id": "P2", "app": "slack.exe", "name": "Slack", "polish": false, "pressEnter": true, "language": "en", "instructions": "Short messages" },
      "expected": { "strength": "off", "pressEnter": true, "language": "en", "extraInstructions": "Short messages", "profileID": "P2", "profileName": "Slack" }
    },
    {
      "name": "the app's preferences come after the global ones; clean-up on as older versions saved it is the standard strength",
      "global": { "strength": "off", "pressEnter": true, "language": "en", "extraInstructions": "  Never use bullet lists\n" },
      "profile": { "id": "P3", "app": "com.microsoft.Outlook", "name": "Outlook", "polish": true, "pressEnter": false, "instructions": "\nUse a formal tone  " },
      "expected": { "strength": "standard", "pressEnter": false, "language": "en", "extraInstructions": "Never use bullet lists\nUse a formal tone", "profileID": "P3", "profileName": "Outlook" }
    },
    {
      "name": "auto-detect overrides a fixed global language",
      "global": { "strength": "standard", "pressEnter": false, "language": "zh", "extraInstructions": "Keep technical terms lowercase" },
      "profile": { "id": "P4", "app": "code.exe", "name": "Visual Studio Code", "language": "", "instructions": "   " },
      "expected": { "strength": "standard", "pressEnter": false, "language": "", "extraInstructions": "Keep technical terms lowercase", "profileID": "P4", "profileName": "Visual Studio Code" }
    },
    {
      "name": "fields of the wrong type or unknown fields count as unset; a missing name is the app",
      "global": { "strength": "polished", "pressEnter": true, "language": "ja", "extraInstructions": "" },
      "profile": { "id": "P5", "app": "wechat.exe", "polish": "no", "strength": 2, "pressEnter": null, "language": 7, "website": "example.com" },
      "expected": { "strength": "polished", "pressEnter": true, "language": "ja", "extraInstructions": "", "profileID": "P5", "profileName": "wechat.exe" }
    },
    {
      "name": "a profile's strength overrides the global one",
      "global": { "strength": "standard", "pressEnter": false, "language": "", "extraInstructions": "" },
      "profile": { "id": "P6", "app": "olk.exe", "name": "Outlook", "polish": true, "strength": "polished" },
      "expected": { "strength": "polished", "pressEnter": false, "language": "", "extraInstructions": "", "profileID": "P6", "profileName": "Outlook" }
    },
    {
      "name": "a profile turns clean-up on at its strength where it's off globally",
      "global": { "strength": "off", "pressEnter": false, "language": "", "extraInstructions": "" },
      "profile": { "id": "P7", "app": "notes.exe", "name": "Notes", "polish": true, "strength": "light" },
      "expected": { "strength": "light", "pressEnter": false, "language": "", "extraInstructions": "", "profileID": "P7", "profileName": "Notes" }
    }
  ],
