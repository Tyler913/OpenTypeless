<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OpenTypeless.UI.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:OpenTypeless.UI"
    Title="OpenTypeless">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: the sidebar and pages extend up under it, like the macOS full-size content view. -->
        <Grid x:Name="TitleBarArea" Grid.Row="0" Background="Transparent" />

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="232"
            SelectionChanged="OnSelectionChanged">

            <NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,0,16,12">
                    <ui:AppTile TileSize="28" />
                    <TextBlock Text="OpenTypeless" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.PaneFooter>
                <ui:StatusPill x:Name="ReadyPill" Margin="16" HorizontalAlignment="Left" />
            </NavigationView.PaneFooter>

            <ContentControl x:Name="PageHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </NavigationView>
    </Grid>
</Window>
