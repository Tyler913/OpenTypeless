<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OpenTypeless.UI.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:OpenTypeless.UI"
    Title="OpenTypeless">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: the sidebar and pages extend up under it, like the macOS full-size content view. -->
        <Grid x:Name="TitleBarArea" Grid.Row="0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,0,0,0" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/AppIcon.png" Width="16" Height="16" />
                <TextBlock Text="OpenTypeless" FontSize="12" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="232"
            SelectionChanged="OnSelectionChanged">

            <NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,4,16,14">
                    <ui:AppTile TileSize="34" />
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="OpenTypeless" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock x:Name="VersionText" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.PaneFooter>
                <ui:StatusPill x:Name="ReadyPill" Margin="16" HorizontalAlignment="Left" />
            </NavigationView.PaneFooter>

            <ContentControl x:Name="PageHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </NavigationView>
    </Grid>
</Window>
